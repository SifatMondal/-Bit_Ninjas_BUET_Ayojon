// Ayojon Database Schema
// PostgreSQL + pgvector for semantic search

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  BUSINESS
  ADMIN
}

enum BookingStatus {
  PENDING        // Initial quote request
  QUOTED         // Business provided quote
  ACCEPTED       // User accepted quote
  PAID           // Payment completed
  CONFIRMED      // Business confirmed
  IN_PROGRESS    // Service in progress
  COMPLETED      // Service completed
  CANCELLED      // Cancelled by either party
  DISPUTED       // Under dispute
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum KYCStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_ACCEPTED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  REVIEW_RECEIVED
  MESSAGE_RECEIVED
  VERIFICATION_STATUS
}

// ============= USER MODELS =============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String? // null for OAuth users
  name          String
  phone         String?
  avatar        String?
  role          Role      @default(USER)
  
  // OAuth
  googleId      String?   @unique
  
  // Preferences
  language      String    @default("en") // en, bn
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  business      Business?
  bookings      Booking[]
  reviews       Review[]
  messages      Message[]
  notifications Notification[]
  searchEvents  SearchEvent[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============= BUSINESS MODELS =============

model Business {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Basic Info
  businessName    String
  slug            String     @unique
  description     String     @db.Text
  logo            String?
  coverImage      String?
  
  // Contact
  phone           String
  whatsapp        String?
  email           String
  website         String?
  
  // Location
  address         String
  city            String
  geoPoint        Json       // { lat: number, lng: number }
  serviceRadius   Int        @default(25) // km
  
  // Business Details
  yearEstablished Int?
  teamSize        String?    // "1-5", "6-10", "11-50", "50+"
  
  // KYC & Verification
  kycStatus       KYCStatus  @default(NOT_STARTED)
  kycDocuments    Json?      // Array of document URLs
  verifiedAt      DateTime?
  rejectionReason String?
  
  // Performance Metrics
  avgRating       Float      @default(0)
  totalReviews    Int        @default(0)
  completedJobs   Int        @default(0)
  responseTime    Int?       // average minutes
  
  // Status
  isActive        Boolean    @default(true)
  isPremium       Boolean    @default(false)
  
  // Timestamps
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  // Relations
  categories      BusinessCategory[]
  listings        Listing[]
  bookings        Booking[]
  reviews         Review[]
  messages        Message[]
  availability    Availability[]
  gallery         Gallery[]

  @@index([slug])
  @@index([city])
  @@index([kycStatus])
  @@index([avgRating])
  @@map("businesses")
}

model ServiceCategory {
  id          String             @id @default(cuid())
  name        String             @unique
  slug        String             @unique
  nameEn      String
  nameBn      String
  description String?
  icon        String?
  image       String?
  isActive    Boolean            @default(true)
  sortOrder   Int                @default(0)
  
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  
  businesses  BusinessCategory[]
  listings    Listing[]

  @@index([slug])
  @@map("service_categories")
}

model BusinessCategory {
  id         String          @id @default(cuid())
  businessId String
  categoryId String
  
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime        @default(now())

  @@unique([businessId, categoryId])
  @@map("business_categories")
}

model Listing {
  id          String          @id @default(cuid())
  businessId  String
  categoryId  String
  
  // Basic Info
  title       String
  slug        String
  description String          @db.Text
  
  // Pricing
  priceMin    Int?            // BDT
  priceMax    Int?            // BDT
  priceUnit   String?         // "per hour", "per day", "per event", "package"
  
  // Features
  features    String[]        // Array of feature strings
  packages    Json?           // Array of package objects { name, price, features[] }
  
  // Media
  images      String[]
  videoUrl    String?
  
  // Search & Discovery
  embedding   Unsupported("vector(1536)")? // OpenAI embedding
  keywords    String[]
  
  // Status
  isActive    Boolean         @default(true)
  viewCount   Int             @default(0)
  
  // Timestamps
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  // Relations
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  bookings    Booking[]

  @@index([businessId])
  @@index([categoryId])
  @@index([slug])
  @@map("listings")
}

model Gallery {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  imageUrl    String
  caption     String?
  sortOrder   Int      @default(0)
  
  createdAt   DateTime @default(now())

  @@index([businessId])
  @@map("galleries")
}

model Availability {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  // Date range or recurring
  startDate   DateTime?
  endDate     DateTime?
  dayOfWeek   Int?     // 0-6 (Sunday-Saturday)
  startTime   String?  // "09:00"
  endTime     String?  // "17:00"
  
  isAvailable Boolean  @default(true)
  note        String?
  
  createdAt   DateTime @default(now())

  @@index([businessId])
  @@map("availability")
}

// ============= BOOKING MODELS =============

model Booking {
  id          String        @id @default(cuid())
  
  // Parties
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id])
  listingId   String?
  listing     Listing?      @relation(fields: [listingId], references: [id])
  
  // Event Details
  eventDate   DateTime
  eventCity   String
  eventAddress String?
  geoPoint    Json?         // { lat, lng }
  
  // Request Details
  description String        @db.Text
  requirements Json?        // Custom requirements
  guestCount  Int?
  duration    String?       // "4 hours", "full day", etc.
  
  // Pricing
  quotedPrice Int?          // BDT - from business
  finalPrice  Int?          // BDT - agreed upon
  
  // Status
  status      BookingStatus @default(PENDING)
  
  // Notes
  userNotes   String?       @db.Text
  businessNotes String?     @db.Text
  
  // Cancellation
  cancelledBy String?       // userId or businessId
  cancelledAt DateTime?
  cancelReason String?
  
  // Timestamps
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  confirmedAt DateTime?
  completedAt DateTime?
  
  // Relations
  payment     Payment?
  review      Review?
  messages    Message[]

  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@index([eventDate])
  @@map("bookings")
}

// ============= PAYMENT MODELS =============

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id])
  
  // Amount
  amount            Int           // BDT
  currency          String        @default("BDT")
  
  // SSLCommerz
  transactionId     String        @unique
  sslSessionId      String?
  bankTransactionId String?
  cardType          String?
  cardIssuer        String?
  
  // Status
  status            PaymentStatus @default(PENDING)
  
  // Gateway Response
  gatewayResponse   Json?
  
  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paidAt            DateTime?

  @@index([transactionId])
  @@index([status])
  @@map("payments")
}

// ============= REVIEW MODELS =============

model Review {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id])
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  
  // Ratings
  rating      Int      // 1-5
  
  // Optional sub-ratings
  qualityRating     Int? // 1-5
  professionalismRating Int? // 1-5
  valueRating       Int? // 1-5
  communicationRating Int? // 1-5
  
  // Review Content
  title       String?
  comment     String   @db.Text
  images      String[] // Review photos
  
  // Response
  response    String?  @db.Text
  respondedAt DateTime?
  
  // Moderation
  isPublished Boolean  @default(true)
  isFlagged   Boolean  @default(false)
  flagReason  String?
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@index([rating])
  @@map("reviews")
}

// ============= MESSAGING =============

model Message {
  id          String   @id @default(cuid())
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id])
  
  // Recipient (business user)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  
  // Content
  content     String   @db.Text
  attachments String[] // URLs
  
  // Status
  isRead      Boolean  @default(false)
  readAt      DateTime?
  
  // Timestamps
  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@index([senderId])
  @@index([businessId])
  @@index([createdAt])
  @@map("messages")
}

// ============= SEARCH & ANALYTICS =============

model SearchEvent {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  
  // Search Query
  query         String
  queryEmbedding Unsupported("vector(1536)")? // For semantic search
  
  // Parsed Intent (from OpenAI)
  parsedIntent  Json?    // { service, city, date, budgetMin, budgetMax, etc. }
  
  // Filters Applied
  categoryId    String?
  city          String?
  budgetMin     Int?
  budgetMax     Int?
  
  // Results
  resultCount   Int      @default(0)
  topResultIds  String[] // Business IDs shown
  
  // Interaction
  clickedResults String[] // Business IDs clicked
  
  // Geo
  userLocation  Json?    // { lat, lng }
  
  // Timestamps
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("search_events")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type       NotificationType
  title      String
  message    String
  link       String?
  
  isRead     Boolean          @default(false)
  readAt     DateTime?
  
  createdAt  DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ============= ADMIN/ANALYTICS =============

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  nameEn    String
  nameBn    String
  slug      String   @unique
  geoPoint  Json     // { lat, lng }
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  
  createdAt DateTime @default(now())

  @@map("cities")
}
